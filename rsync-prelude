@dataclass
class FileInfo:
    # parsed from output
    filename: str
    is_dir: bool
    size: int
    timestamp: datetime

    # for candidates:
    # additionally computed hashsum, or the size if it is unique in file set
    hashsum: Optional[str]

class StdoutIterator:
    def __init__(self, process: subprocess.Popen): # subprocess.Popen[str])
        self.process = process

    def __iter__(self) -> Iterator[str]:
        return self

    def __next__(self) -> str:
        if self.process.stdout is None:
            cmd = self.process.args
            print(f"error: command has no output: {cmd}")
            sys.exit(5)
        try:
            line = next(self.process.stdout)
        except StopIteration:
            self.process.stdout.close()
            returncode = self.process.wait()
            if returncode != 0:
                cmd = self.process.args
                print(f"error: command failed with code {returncode}: {cmd}")
                sys.exit(2)
            else:
                raise
        else:
            return line[:-1] # omit newline character

def progress_reset() -> None:
    """Reset progress display."""
    if progress > 0:
        # go to beginning of previous line and erase line
        print("\033[A\r\033[K", end="", flush=True)

def run(cmd: str) -> Iterator[str]:
    """Run command and return iterator on standard output lines."""
    if verbose:
        print(f"run: {cmd}")
    if progress > 0:
        if len(cmd) + len("running: ") > progress:
            pw = (progress - len("running: ") - len("..."))//2
            cmd_p = cmd[:pw] + "..." + cmd[-pw:]
        else:
            cmd_p = cmd
        print(f"running: {cmd_p}", flush=True)
    process = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, text=True, bufsize=1, encoding="utf-8")
    return StdoutIterator(process)

def run0(cmd: str) -> None:
    """Run command while ensuring no standard output."""
    it = run(cmd)
    try:
        line = next(it)
    except StopIteration:
        pass
    else:
        print(f"error: command produced unexpected output: {cmd}: {line}")
        sys.exit(3)
    progress_reset()

def run1(cmd: str) -> str:
    """Run command and return the only line of its standard output."""
    it = run(cmd)
    line = next(it)
    try:
        line2 = next(it)
    except StopIteration:
        pass
    else:
        print(f"error: command produced more than one line: {cmd}: {line2}")
        sys.exit(4)
    progress_reset()
    return line

def rsync_list_cmd(args, dir: str) -> str:
    """Command to list rsync candidate files."""
    return f"TZ=UTC0 rsync {args.filter_args} -e '{args.rsh}' --list-only {dir}"

def rsync_list(args, dir: str) -> Dict[str, FileInfo]:
    """Return FileInfo objects for each rsync candidate."""
    ret = {}
    for line in run(rsync_list_cmd(args, dir)):
        try:
            [permissions, size, date, time, path] = line.split(maxsplit=4)
            is_dir = (permissions[0] == "d")
            sz = int(size.replace(".", "").replace(",", ""))
            timestamp = datetime.strptime(f"{date} {time}", '%Y/%m/%d %H:%M:%S')
            timestamp = timestamp.replace(tzinfo=timezone.utc)
        except ValueError:
            print(f"error: unexpected 'rsync --list-only' output line: {line}")
            sys.exit(1)
        else:
            ret[path] = FileInfo(Path(path).name, is_dir, sz, timestamp, hashsum=None)
    progress_reset()
    return ret

def hashsum(args, path: str, is_src: bool=True) -> str:
    """Compute hashsum of a file (at source or target)."""
    root = args.SRC if is_src else args.DEST
    is_local = root.split("/")[0].find(":") < 0

    if is_local:
        cmd_pref = ""
        if root.endswith("/"):
            filepath = f"{root}{path}"
        else:
            if is_src:
                filepath = str(Path(root).parent / path)
            else:
                filepath = f"{root}/{path}"
    else:
        remote_host, remote_dir = root.split(":")
        cmd_pref = f"{args.rsh} {remote_host} "
        if root.endswith("/"):
            filepath = f"{remote_dir}{path}"
        else:
            if is_src:
                filepath = str(Path(remote_dir).parent / path)
            else:
                filepath = f"{remote_dir}/{path}"
    cmd = f"{args.hash_tool} {quote(filepath)}"
    if not is_local:
        cmd = f"{cmd_pref}{quote(cmd)}"

    ret = run1(cmd)
    return ret.split()[0]

def dst_cmd(args, cmd: str, arg1: str, arg2: str) -> str:
    root: str = args.DEST
    is_local: bool = root.split("/")[0].find(":") < 0

    if not is_local:
        remote_host: str
        remote_host, root = root.split(":")

    def wrap_cmd(cmd: str) -> str:
        if is_local:
            return cmd
        else:
            cmd_pref = f"{args.rsh} {remote_host} "
            return f"{cmd_pref}{quote(cmd)}"

    def fullpath(path: str) -> str:
        if root.endswith("/"):
            return f"{root}{path}"
        else:
            return f"{root}/{path}"

    if cmd == "touch":
        timestamp = arg1
        trg_path = arg2
        trg = fullpath(trg_path)
        return wrap_cmd(f"TZ=UTC0 touch -c -t {timestamp} {quote(trg)}")
    else:
        src_path = arg1
        trg_path = arg2
        src, trg = fullpath(src_path), fullpath(trg_path)
        trgdir = "/".join(trg.split("/")[:-1]) or "."
        return wrap_cmd(f"mkdir -p {quote(trgdir)} && {cmd} {quote(src)} {quote(trg)}")

